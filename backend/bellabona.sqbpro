SET description = 'Tender grilled chicken served over seasoned brown rice with roasted vegetables and a fresh citrus herb dressing.'
WHERE id = 1;

UPDATE dishes
SET description = 'Fresh avocado, crunchy greens, cherry tomatoes, and roasted seeds tossed in a light lemon vinaigrette.'
WHERE id = 2;

UPDATE dishes
SET description = 'Pan-seared salmon glazed with savory miso sauce, paired with steamed rice and seasonal vegetables.'
WHERE id = 3;

UPDATE dishes
SET description = 'Crispy herb falafel wrapped in warm flatbread with lettuce, tomato, pickled onions, and garlic sauce.'
WHERE id = 4;

UPDATE dishes
SET description = 'Fresh poke bowl with teriyaki-glazed protein, jasmine rice, cucumber, edamame, and sesame toppings.'
WHERE id = 5;

UPDATE dishes
SET description = 'Oven-baked sweet potato served with mixed greens, creamy yogurt dressing, and toasted herbs.'
WHERE id = 6;</sql><current_tab id="0"/></tab_sql></sqlb_project>
